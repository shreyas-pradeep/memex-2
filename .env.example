# Optional. Enables the live Gemini Ghost Engine through /api/ghost.
# Get a free key at https://aistudio.google.com/apikey and put it in .env.local
# (git-ignored). Never commit a real key, and never prefix it with NEXT_PUBLIC_.
# Without it, the app uses the built-in offline neural engine (or a key saved in
# the browser through the AI settings dialog).
GEMINI_API_KEY=
# Optional: model tried first (falls back to gemini-2.0-flash, then gemini-1.5-flash).
# GEMINI_MODEL=gemini-2.0-flash
